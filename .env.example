# Configurazione invio email dei form (Affiliazione, Contatti)
# Copiare in .env.local per lo sviluppo, e impostare le stesse variabili su Vercel per la produzione.
# Funziona con qualsiasi casella SMTP (dominio gratuito, Zoho, ecc.).

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=info@iktaworld.com
SMTP_PASS=la-password-della-casella
MAIL_FROM="IKTA Sito <info@iktaworld.com>"

# Destinatari dei form: piu indirizzi separati da virgola (arrivano a tutti).
# Es. la casella del gestore + quella del proprietario.
MAIL_TO=info@iktaworld.com,massimo.brizi@tiscali.it
